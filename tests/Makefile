MAIN_DIR=..
SDSL_DIR=../../sdsl-lite
include $(SDSL_DIR)/Make.helper

# Generated by GBWT's Makefile from whatever build-time options (e.g.
# GBWT_ENABLE_SHARED_MEMORY) $(LIBRARY) below was actually built with, so
# we don't have to separately re-detect them here (and risk disagreeing
# with the library).
#
# A leading "-" tolerates this not existing yet: `make clean` recurses
# here before `all`/`test` ever need the variables it defines, and a
# fresh checkout has no Make.helper until `make` (or `make test`) has run
# at least once in $(MAIN_DIR).
-include $(MAIN_DIR)/Make.helper

LIBRARY=$(MAIN_DIR)/lib/libgbwt.a

# Directories for dependencies.
INCLUDES=-I$(MAIN_DIR)/include -I$(INC_DIR) $(GBWT_INCLUDES)
LIBS=-L$(LIB_DIR) -lsdsl -lgtest -lgtest_main $(GBWT_LIBS)

# Apple Clang does not support OpenMP directly; gtest also isn't in
# pkg-config and can't be found by default if installed via Homebrew.
# ($(MAIN_DIR)/Make.helper's GBWT_PARALLEL_FLAGS already handles the
# Homebrew-libomp side of this for us.)
ifeq ($(shell uname -s), Darwin)
    ifeq ($(shell if [ -e $(HOMEBREW_PREFIX)/lib/libgtest.a ]; then echo 1; else echo 0; fi), 1)
        $(info Found gtest installed by Homebrew and linked to $(HOMEBREW_PREFIX).)
        INCLUDES += -I$(HOMEBREW_PREFIX)/include
        LIBS += -L$(HOMEBREW_PREFIX)/lib
    endif
endif

CXX_FLAGS=$(MY_CXX_FLAGS) $(GBWT_PARALLEL_FLAGS) $(GBWT_DEFINES) $(MY_CXX_OPT_FLAGS) $(INCLUDES)

HEADERS=$(wildcard $(MAIN_DIR)/include/gbwt/*.h)
PROGRAMS=test_utils test_support test_metadata test_gbwt test_bwtmerge test_queries test_variants

.PHONY: all clean test
all:$(PROGRAMS)

%.o:%.cpp $(HEADERS)
	$(MY_CXX) $(CXX_FLAGS) -c $<

$(PROGRAMS):%:%.o $(LIBRARY)
	$(MY_CXX) $(CXX_FLAGS) -o $@ $< $(LIBRARY) $(LIBS)

test:$(PROGRAMS)
	$(foreach PROG,$(PROGRAMS),./$(PROG) || exit 1;)

clean:
	rm -f $(PROGRAMS) *.o
